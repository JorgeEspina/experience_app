rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's role from their users/{uid} document.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerRole() == 'admin';
    }

    // ---- Products (catalog) ----
    // Any signed-in user can browse; only admins can create/update/delete.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- User profiles ----
    // A user can read and manage their own profile. Admins can read any
    // profile. Nobody can grant themselves the admin role from the client:
    // the role is only settable from the Firebase console / server, and a
    // user updating their own doc must keep the same role they already have.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Creating your own profile: role must be "client".
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'client';

      // Updating your own profile: cannot change the role.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      // Admins can update any profile (e.g. promote/demote roles).
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ---- Orders ----
    // A user can read and create their own orders. Orders are immutable:
    // no updates or deletes from the client.
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Everything else: denied by default ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
